graph TB
    subgraph "Online State"
        ON1[User Opens App<br/>WiFi Connected]
        ON2[Check for Updates]
        ON3[Sync Local Data]
        ON4[Download New Content]
        ON5[Update Cache]
    end
    
    subgraph "Mobile App - Offline Core"
        APP[App Shell]
        APP1[Service Worker<br/>PWA Capabilities]
        APP2[IndexedDB<br/>Structured Data]
        APP3[SQLite Database<br/>User & Progress Data]
        APP4[File System<br/>Video/Audio Files]
        APP5[Queue Manager<br/>Pending Operations]
    end
    
    subgraph "Content Strategy"
        CS1[Pre-downloaded Content]
        CS2[Smart Caching<br/>Next Lesson Prediction]
        CS3[Compression<br/>H.264/H.265]
        CS4[Adaptive Quality<br/>Multiple Resolutions]
        CS5[Incremental Loading<br/>Lesson by Lesson]
    end
    
    subgraph "Sync Engine"
        SYNC[Bidirectional Sync]
        SYNC1[Conflict Resolution<br/>Last Write Wins]
        SYNC2[Delta Sync<br/>Only Changed Data]
        SYNC3[Batch Operations<br/>Reduce API Calls]
        SYNC4[Exponential Backoff<br/>Retry Failed Syncs]
    end
    
    subgraph "Local Operations"
        LO1[Watch Videos<br/>From Cache]
        LO2[Track Progress<br/>Local Storage]
        LO3[Voice Commands<br/>Offline STT]
        LO4[Browse Content<br/>Cached Metadata]
        LO5[View Profile<br/>Local Stats]
    end
    
    subgraph "Offline Queue"
        Q1[Pending Progress Updates]
        Q2[Pending Course Completions]
        Q3[Pending Achievements]
        Q4[Pending Analytics Events]
        Q5[Pending Content Requests]
    end
    
    subgraph "Network Detection"
        NET[Network Monitor]
        NET1[Check Connectivity<br/>Every 30 seconds]
        NET2[WiFi Available?]
        NET3[Mobile Data Available?]
        NET4[Connection Quality<br/>Speed Test]
    end
    
    subgraph "Sync Triggers"
        TRIG1[Manual Sync<br/>User Initiated]
        TRIG2[Auto Sync<br/>WiFi Connected]
        TRIG3[Background Sync<br/>App in Background]
        TRIG4[Scheduled Sync<br/>Every 6 hours]
    end
    
    subgraph "Offline State"
        OFF1[User Opens App<br/>No Internet]
        OFF2[Load from Cache]
        OFF3[Show Offline Banner]
        OFF4[Enable Offline Features]
        OFF5[Queue New Operations]
    end
    
    subgraph "Content Update Strategy"
        UP1[Check Server Version]
        UP2[Compare Local Version]
        UP3[Download Delta Updates]
        UP4[Apply Updates Atomically]
        UP5[Rollback on Failure]
    end
    
    %% Online Flow
    ON1 --> ON2
    ON2 --> UP1
    UP1 --> UP2
    UP2 -->|Updates Available| UP3
    UP3 --> UP4
    UP4 -->|Success| UP5
    UP4 -->|Failure| UP5
    UP5 --> ON3
    ON3 --> SYNC
    ON3 --> Q1
    ON3 --> Q2
    ON3 --> Q3
    ON3 --> Q4
    ON3 --> Q5
    
    %% Sync Engine
    SYNC --> SYNC1
    SYNC --> SYNC2
    SYNC --> SYNC3
    SYNC --> SYNC4
    
    %% Queue Processing
    Q1 --> SYNC
    Q2 --> SYNC
    Q3 --> SYNC
    Q4 --> SYNC
    Q5 --> ON4
    
    %% Content Download
    ON4 --> CS1
    ON4 --> CS2
    CS2 --> CS3
    CS3 --> CS4
    CS4 --> CS5
    CS5 --> ON5
    ON5 --> APP4
    
    %% App Storage
    APP --> APP1
    APP --> APP2
    APP --> APP3
    APP --> APP4
    APP --> APP5
    
    %% Local Operations (Offline Mode)
    OFF1 --> OFF2
    OFF2 --> APP4
    APP4 --> LO1
    OFF2 --> APP3
    APP3 --> LO2
    OFF2 --> OFF3
    OFF3 --> OFF4
    OFF4 --> LO1
    OFF4 --> LO2
    OFF4 --> LO3
    OFF4 --> LO4
    OFF4 --> LO5
    
    %% Queue New Operations
    LO2 --> OFF5
    OFF5 --> APP5
    APP5 --> Q1
    APP5 --> Q2
    APP5 --> Q3
    APP5 --> Q4
    
    %% Network Detection
    NET --> NET1
    NET1 --> NET2
    NET1 --> NET3
    NET2 -->|Yes| NET4
    NET3 -->|Yes| NET4
    NET4 -->|Good| TRIG2
    NET4 -->|Poor| TRIG3
    
    %% Sync Triggers
    TRIG1 --> SYNC
    TRIG2 --> SYNC
    TRIG3 --> SYNC
    TRIG4 --> SYNC
    
    %% Smart Caching Logic
    LO1 -.->|Predict Next| CS2
    CS2 -.->|Pre-fetch| ON4
    
    %% Conflict Resolution Examples
    SYNC1 -.->|Example: Progress Conflict<br/>Server: 50%, Local: 60%<br/>Resolution: Keep 60%| APP3
    
    %% Offline to Online Transition
    NET2 -->|Becomes Available| ON1
    NET3 -->|Becomes Available| ON1
    
    %% Online to Offline Transition
    NET2 -->|Lost Connection| OFF1
    NET3 -->|Lost Connection| OFF1
    
    %% Background Sync
    TRIG3 -.->|Upload Queue| APP5
    APP5 -.->|Process| SYNC
    
    %% Data Prioritization
    SYNC3 -.->|Priority 1: Progress Updates| Q1
    SYNC3 -.->|Priority 2: Completions| Q2
    SYNC3 -.->|Priority 3: Analytics| Q4
    
    %% Storage Management
    APP4 -.->|Low Storage Warning<br/>< 500MB| CS1
    CS1 -.->|Delete Old Content| APP4
    
    %% Retry Logic
    SYNC4 -.->|Attempt 1: Immediate| NET
    SYNC4 -.->|Attempt 2: 30s| NET
    SYNC4 -.->|Attempt 3: 2min| NET
    SYNC4 -.->|Attempt 4: 10min| NET
    SYNC4 -.->|Attempt 5: 1hr| NET
    
    style ON1 fill:#2ecc71,stroke:#27ae60,stroke-width:3px
    style OFF1 fill:#e74c3c,stroke:#c0392b,stroke-width:3px
    style APP fill:#3498db,stroke:#2980b9,stroke-width:3px
    style SYNC fill:#9b59b6,stroke:#8e44ad,stroke-width:3px
    style NET fill:#f39c12,stroke:#e67e22,stroke-width:2px
    style CS1 fill:#1abc9c,stroke:#16a085,stroke-width:2px
    style APP4 fill:#34495e,stroke:#2c3e50,stroke-width:2px
