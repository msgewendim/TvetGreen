{
  "expo": {
    "name": "TvetGreen Skill Hub",
    "slug": "tvetgreen-skill-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logos/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "TVET Green learning platform - Access courses and educational content",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logos/icon.png",
      "name": "TvetGreen Skill Hub",
      "shortName": "TvetGreen",
      "lang": "en",
      "scope": "/",
      "themeColor": "#000000",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "crossorigin": "use-credentials",
      "preferRelatedApplications": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/163033fb-20b0-4b5f-83b1-80e25c89cb3d"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "163033fb-20b0-4b5f-83b1-80e25c89cb3d"
      }
    },
    "android": {
      "package": "com.misganaw.builder"
    }
  }
}
